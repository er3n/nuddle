# Environment of apps/web (src/api/production.ts). Copy what you need to apps/web/.env.local
# (git-ignored). `mise run dev` sets the Supabase values from the local stack and the two shared
# secrets from mise.toml. Never commit real values.
#
# Vercel (docs/architecture.md, Environments): Production target only. Preview deployments get no
# variables and serve only /api/v1/health. Secrets are added as "sensitive" from ~/.nuddle/prod
# (docs/human-checklist.md, Before stage 7). Vercel itself sets VERCEL_ENV and
# VERCEL_GIT_COMMIT_SHA (the version health reports).

# Postgres and Supabase. Production: the transaction pooler (port 6543) with ?sslmode=require. The
# direct host is IPv6 only and Vercel functions cannot reach it. Without DATABASE_URL the app
# serves only /api/v1/health.
DATABASE_URL=
SUPABASE_URL=
# The project's secret (service role) key: Auth admin, Storage.
SUPABASE_SECRET_KEY=

# Internal endpoints. TICK_SECRET is also stored in Supabase Vault as `tick_secret`.
TICK_SECRET=
# Supabase Send SMS hook secret, "v1,whsec_<base64>".
SEND_SMS_HOOK_SECRET=

# SMS (Twilio, ADR 0014). Without these, sending a code fails (test numbers still work). Empty in
# Vercel until the beta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Messaging Service SID (MG...) or a sender number.
TWILIO_FROM=
# Android SMS Retriever app hash, appended to the SMS (stage 5). Empty until the signed prod app.
SMS_RETRIEVER_HASH=

# Sign-in codes over WhatsApp (ADR 0029). Until all four are set every code goes by SMS, as before.
# The WhatsApp sender number in E.164 (the Twilio number registered as a WhatsApp sender).
TWILIO_WHATSAPP_FROM=
# Content SIDs (HX...) of the approved authentication templates: Turkish for +90, English otherwise.
TWILIO_WHATSAPP_TEMPLATE_SID_TR=
TWILIO_WHATSAPP_TEMPLATE_SID_EN=
# Encrypts the code held up to 10 minutes for the SMS fallback: base64 of 32 random bytes
# (`openssl rand -base64 32`). Vercel env only, never in the repo.
OTP_CODE_KEY=
# The public origin Twilio posts message statuses to (/api/internal/twilio-status) and signs.
# Defaults to https://nuddle.app; set it to a tunnel to receive callbacks locally.
PUBLIC_BASE_URL=

# Push (FCM). The service account key JSON on one line. Without it, pushes are only logged.
# Production until the beta: the FCM-only service account of the dev project nuddle-app-er3n.
FIREBASE_SERVICE_ACCOUNT=

# LLM extraction (docs/architecture.md, LLM). Required outside E2E mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# E2E mode (docs/testing.md): test endpoints, fixture extractor, compressed plans. Never set in
# Vercel: it would expose /api/test/*.
E2E=
E2E_EXTRACTOR_FIXTURES=../../e2e/fixtures/extractions.json
