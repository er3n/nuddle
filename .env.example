# Environment of apps/web (src/api/production.ts). Copy what you need to apps/web/.env.local
# (git-ignored). `mise run dev` sets the Supabase values from the local stack and the two shared
# secrets from mise.toml; production values live in Vercel env (stage 7). Never commit real values.

# Postgres and Supabase
DATABASE_URL=
SUPABASE_URL=
# The project's secret (service role) key: Auth admin, Storage.
SUPABASE_SECRET_KEY=

# Internal endpoints. TICK_SECRET is also stored in Supabase Vault as `tick_secret`.
TICK_SECRET=
# Supabase Send SMS hook secret, "v1,whsec_<base64>".
SEND_SMS_HOOK_SECRET=

# SMS (Twilio, ADR 0014). Without these, sending a code fails (test numbers still work).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Messaging Service SID (MG...) or a sender number.
TWILIO_FROM=
# Android SMS Retriever app hash, appended to the SMS (stage 5).
SMS_RETRIEVER_HASH=

# Push (FCM). The service account key JSON on one line. Without it, pushes are only logged.
FIREBASE_SERVICE_ACCOUNT=

# LLM extraction (docs/architecture.md, LLM). Required outside E2E mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# E2E mode (docs/testing.md): test endpoints, fixture extractor, compressed plans.
E2E=
E2E_EXTRACTOR_FIXTURES=../../e2e/fixtures/extractions.json
