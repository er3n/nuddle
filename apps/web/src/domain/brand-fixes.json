        },
        {
          "id": "battery",
          "title": "Arka planda yüksek güç kullanımı",
          "hint": "Açılan sayfada \"Pil\"e dokun, arka planda yüksek güç kullanımına izin ver.",
          "targets": [
            { "action": "android.settings.APPLICATION_DETAILS_SETTINGS", "withPackage": true }
          ]
        }
      ]
    },
    "default": {
      "reason": null,
      "steps": [
        {
          "id": "battery",
          "title": "Pil kullanımı: Kısıtlanmamış",
          "hint": "Açılan sayfada \"Pil\"e dokun, \"Kısıtlanmamış\"ı seç.",
          "check": "battery_optimization",
          "targets": [
            { "action": "android.settings.APPLICATION_DETAILS_SETTINGS", "withPackage": true }
