{
  "$comment": "Design tokens for the Compose theme. Source: Dürt Mobil UX canvas and developer handoff (2026-10-10). Canvas px map 1:1 to dp (sp for text). Light theme only in the MVP. Colors are only constructed in the theme package.",
  "color": {
    "ink": { "value": "#11151A", "use": "Main text, primary button background, the user's own avatar" },
    "surface": { "value": "#FFFFFF", "use": "Cards, list groups, bottom sheets" },
    "background": { "value": "#F2F4F6", "use": "Screen background, message box inside cards" },
    "surfaceMuted": { "value": "#EEF1F4", "use": "List dividers, soft button background" },
    "border": { "value": "#DDE2E7", "use": "Card and group border (1 dp)" },
    "borderStrong": { "value": "#C9D0D7", "use": "Unselected chip, input border, switch off" },
    "textBody": { "value": "#3B4550", "use": "Long descriptive text" },
    "textSecondary": { "value": "#4D5763", "use": "Sub lines, descriptions" },
    "textTertiary": { "value": "#5A6470", "use": "Section labels, times, hints" },
    "textMuted": { "value": "#8A96A3", "use": "Chevrons, error codes, decoration only. Never for text that must be read." },
    "accent": { "value": "#FF5A1F", "use": "Brand orange: mic, accent actions (Bir dene, Ayarları aç), logo dot. Text on accent is always ink, never white." },
    "poke": { "value": "#C83C08", "use": "Full screen poke background, unread dot, badge" },
    "pokeDeep": { "value": "#A93206", "use": "Boxes and labels on the full screen poke" },
    "pokeRing": { "value": "#E8774C", "use": "Rings on the full screen poke" },
    "onPokeSoft": { "value": "#FFF1EB", "use": "Secondary text on the full screen poke" },
    "link": { "value": "#C23A06", "pressed": "#8F2A03", "use": "Text links" },
    "success": { "value": "#0F6E5C", "use": "Done button in notifications, switch on, Call button" },
    "successSoft": { "value": "#DDF1EC", "use": "Completed mark background" },
    "onSuccessSoft": { "value": "#0B5446", "use": "Tick icon" },
    "warning": { "value": "#9A2E05", "use": "Warning icon and text" },
    "warningSoft": { "value": "#FFF1E8", "use": "Inline alert background" },
    "warningBorder": { "value": "#FFB596", "use": "Inline alert border" },
    "warningPill": { "value": "#FFE3D6", "use": "Sırada, Gerekli, Tekrar istendi pills" },
    "onWarningPill": { "value": "#7A2604" },
    "highlightSoft": { "value": "#FFF6F1", "use": "Missing info question box (2b), OTP error fill" },
    "highlightBorder": { "value": "#FFD6C4" },
    "danger": { "value": "#7A1A1A", "use": "Delete account, cancel, Kaçırıldı pill (filled)" },
    "infoPill": { "value": "#E2EAFB", "use": "Onayını bekliyor pill" },
    "onInfoPill": { "value": "#1A43A3" },
    "neutralPill": { "value": "#E3E7EB", "use": "Kurulu, Bırakıldı, İptal edildi pills" },
    "onNeutralPill": { "value": "#3B4550" },
    "scrim": { "value": "#11151A", "alpha": 0.5, "use": "Behind bottom sheets" },
    "toast": { "background": "#11151A", "button": "#2C333B", "tick": "#7FD8C3", "progress": "#FF5A1F" },
    "dark": { "background": "#11151A", "surface": "#1C222A", "border": "#2C333B", "text": "#FFFFFF", "textSecondary": "#C9D0D7", "use": "Welcome (0a, 0b) and Matched (0g) screens only, not a dark theme" },
    "illustration": { "screen": "#3B6FE0", "bread": "#E8B26A", "breadCrust": "#B9823F", "sweat": "#8FD3FF", "sparkle": "#FFD23F", "use": "Drawings on the web landing page (Landing.dc.html) only" },
    "avatar": {
      "self": "#11151A",
      "others": "Six colors derived deterministically from the person id, each with at least 4.5:1 contrast against white text. Palette is an open question; #C83C08 is the first (Sibel in the design)."
    }
  },
  "typography": {
    "families": {
      "display": "Space Grotesk (500, 600, 700), letter spacing -0.02em on headings",
      "text": "IBM Plex Sans (400, 500, 600, 700)",
      "source": "Google Fonts, OFL. Embedded under res/font as TTF. Follow the system font scale (sp)."
    },
    "styles": {
      "displayPoke": { "family": "display", "weight": 700, "size": 44, "lineHeight": 44, "use": "Full screen poke title" },
      "h1": { "family": "display", "weight": 700, "size": 30, "lineHeight": 33, "use": "Screen title (Merhaba Eren, task title)" },
      "h2": { "family": "display", "weight": 700, "size": 26, "lineHeight": 29, "use": "Bottom sheet title, error title" },
      "h3": { "family": "display", "weight": 700, "size": 24, "lineHeight": 28, "use": "Back bar title" },
      "brand": { "family": "display", "weight": 700, "size": 22, "use": "Logo, profile name" },
      "onboardingTitle": { "family": "display", "weight": 700, "size": 32, "lineHeight": 35, "use": "Sign-in screens (0c to 0f), from the canvas" },
      "welcomeTitle": { "family": "display", "weight": 700, "size": 40, "lineHeight": 41, "use": "Welcome headline (0a, 0b)" },
      "bodyLarge": { "family": "text", "weight": 400, "size": 17, "lineHeight": 24, "use": "Full screen sub text" },
      "input": { "family": "text", "weight": 400, "size": "15 focused / 14 idle", "lineHeight": 1.4, "use": "Compose box (smaller since NUD-48, after the phone test)" },
      "body": { "family": "text", "weight": "400 or 600", "size": 15, "lineHeight": 22, "use": "List rows, card titles (600), descriptions" },
      "bodySmall": { "family": "text", "weight": 400, "size": 14, "lineHeight": 20, "use": "Message inside cards, button text (600)" },
      "caption": { "family": "text", "weight": 400, "size": 13, "lineHeight": 19, "use": "Card sub line, hints" },
      "overline": { "family": "text", "weight": 600, "size": 12, "letterSpacing": "0.06em", "uppercase": true, "use": "Section labels (SANA YAZILANLAR)" },
      "micro": { "family": "text", "weight": 600, "size": "11-12", "use": "Badge count, pills" }
    }
  },
  "space": {
    "screenPaddingHorizontal": 20,
    "screenPaddingHorizontalSmallPhone": 16,
    "screenPaddingBottom": 24,
    "screenPaddingTop": "status bar inset + 8",
    "steps": [4, 6, 8, 10, 12, 14, 16, 20, 24],
    "verticalFlow": "14-16",
    "minTouchTarget": 44
  },
  "size": {
    "button": { "poke": 62, "large": 56, "largeAlt": 58, "medium": 52, "small": 44, "compact": 40 },
    "listRow": { "single": 52, "withDescription": 64 },
    "avatar": { "hero": 88, "profile": 64, "topBar": 44, "notification": 40, "list": 36, "card": 32, "inline": 28, "small": 24 },
    "switch": { "width": 52, "height": 32, "thumb": 26 },
    "pill": { "height": 24, "paddingHorizontal": 10 },
    "bottomSheetHandle": { "width": 40, "height": 5 },
    "designWidth": 390,
    "smallPhoneWidth": 360
  },
  "radius": {
    "pill": 999,
    "sheet": 26,
    "xl": 20,
    "l": 18,
    "m": 16,
    "s": "12-14"
  },
  "border": { "card": 1, "secondaryButtonAndChip": 1.5, "focused": 2 },
  "elevation": "None. Depth comes from background tone differences. The only shadow is the decorative one on the welcome illustration.",
  "motion": {
    "durationMs": "150-250",
    "crossfadeMicToSend": 150,
    "toastEnter": 200,
    "undoToastMs": 5000,
    "undoToastTalkBackMs": 10000,
    "doneNoteMs": 4000,
    "voicePulseMs": 1600,
    "voicePulse": "Ring around the 4h mic: scale 1 to 1.7, opacity 0.55 to 0, ease-out, repeating (VoiceHold.dc.html)",
    "reducedMotion": "Toasts and sheets appear instantly; poke rings stay static"
  }
}
