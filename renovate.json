{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor",
    ":pinAllExceptPeerDependencies"
  ],
  "timezone": "Europe/Istanbul",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Major updates are grouped per manager so each ecosystem lands in one PR",
      "matchUpdateTypes": ["major"],
      "groupName": "major ({{manager}})"
    },
    {
      "description": "typescript-eslint pins the supported TypeScript range; update them together",
      "matchPackageNames": ["typescript", "typescript-eslint"],
      "groupName": "typescript"
    }
  ]
}
